{
  // Zenoh 客户端配置 - 用于设备和Agent连接到网关
  mode: "client",
  connect: {
    endpoints: [
      "tls/gateway-router-1:7447",  // 连接到网关Router-1（容器内通过服务名访问）
      "tls/gateway-router-2:7447",  // 连接到网关Router-2 (备用)
      "tls/gateway-router-3:7447"   // 连接到网关Router-3 (备用)
    ],
  },
  transport: {
    link: {
      tls: {
        root_ca_certificate: "/app/certs/ca-cert.pem",
        // 私钥和证书文件将在运行时根据租户动态设置
        // connect_private_key: "/app/certs/xxx-key.pem",
        // connect_certificate: "/app/certs/xxx-cert.pem",
      },
    },
  },
  scouting: {
    multicast: {
      enabled: false,
    },
    gossip: {
      enabled: false,
    },
  },
}
