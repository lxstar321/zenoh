{
  id: "e4f67f890abcdef1234567890abcdef0",

  connect: {
    endpoints: [
      "tls/gateway-router-1:7447",
      "tls/gateway-router-3:7447"
    ]
  },

  transport: {
    link: {
      tls: {
        root_ca_certificate: "/app/certs/ca-cert.pem",
        connect_private_key: "/app/certs/collector-key.pem",
        connect_certificate: "/app/certs/collector-cert.pem"
      }
    }
  },

  scouting: {
    multicast: {
      enabled: false
    },
    gossip: {
      enabled: false
    }
  }
}
